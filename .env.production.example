# ==============================================================================
# Pressmark Vector Document Engine - Production Environment Configuration
# Author: Daniel Hallman
# ==============================================================================

# Network & Host Binding
PRESSMARK_HOST=127.0.0.1
PRESSMARK_PORT=3842
PRESSMARK_BASE_URL=https://pressmark.dev

# Pressmark Vector Engine Binary & Paths
PRESSMARK_TYPST_BIN=/usr/local/bin/typst
PRESSMARK_ENGINE_BIN=/usr/local/bin/typst

# Persistent Database & Cache Storage
PRESSMARK_DB_PATH=/var/lib/pressmark/pressmark.db
PRESSMARK_CACHE_DIR=/var/cache/pressmark

# Security, Request Sizing & Rate Limiting
# Maximum payload size in megabytes (default: 25MB for high-PPI raster/vector logos)
PRESSMARK_BODY_LIMIT_MB=25
# Sliding window rate limit: max requests per IP window
PRESSMARK_RATE_LIMIT_MAX=120
# Rate limit window duration in seconds
PRESSMARK_RATE_LIMIT_WINDOW=60
# Trust upstream reverse proxy headers (X-Forwarded-For, X-Real-IP, CF-Connecting-IP)
PRESSMARK_TRUST_PROXY_HEADERS=true

# "Sign in with ChatGPT" & OpenAI Integration
OPENAI_CHATGPT_CLIENT_ID=pressmark-app-client

# Stripe Payments & Webhook Infrastructure
# Master Mode Toggle: set to true to process live transactions, false for test mode
STRIPE_LIVE_MODE=false
STRIPE_ACCOUNT_ID=acct_1UMGLCC4BgtWu7w5

# Test Mode Credentials & Webhooks
STRIPE_SECRET_KEY_TEST=sk_test_...
STRIPE_PUBLISHABLE_KEY_TEST=pk_test_...
STRIPE_WEBHOOK_SECRET_TEST=whsec_...

# Test Catalog Price IDs & 1-Tap Links
STRIPE_SOLO_PRICE_ID_TEST=price_1UMGQ3CMp4h3TImnQKRlITxH
STRIPE_BUSINESS_PRICE_ID_TEST=price_1UMGQDCMp4h3TImnYr6UD5iu
STRIPE_AGENCY_PRICE_ID_TEST=price_1UMGQECMp4h3TImnVUo683St
STRIPE_SINGLE_PASS_PRICE_ID_TEST=price_1UMGQGCMp4h3TImncx55yMqJ
STRIPE_STARTER_PACK_PRICE_ID_TEST=price_1UMGQHCMp4h3TImnjVuQ46Ov
STRIPE_SOLO_CHECKOUT_URL_TEST=https://buy.stripe.com/test_28EcN4eQu9MJfaR1ADgbm00
STRIPE_BUSINESS_CHECKOUT_URL_TEST=https://buy.stripe.com/test_fZu9AS23I4spfaR1ADgbm01
STRIPE_AGENCY_CHECKOUT_URL_TEST=https://buy.stripe.com/test_fZucN437M7EB8Mtgvxgbm02
STRIPE_PASS_24H_CHECKOUT_URL_TEST=https://buy.stripe.com/test_dRm00igYC4sp7Ipfrtgbm03
STRIPE_CREDIT_PACK_CHECKOUT_URL_TEST=https://buy.stripe.com/test_aFa5kCbEi2kh0fXfrtgbm04

# Live Mode Credentials & Webhooks
STRIPE_SECRET_KEY_LIVE=sk_live_...
STRIPE_PUBLISHABLE_KEY_LIVE=pk_live_...
STRIPE_WEBHOOK_SECRET_LIVE=whsec_...

# Live Catalog Price IDs (populated once live products are created in live dashboard)
STRIPE_SOLO_PRICE_ID_LIVE=price_live_solo_monthly_pressmark
STRIPE_BUSINESS_PRICE_ID_LIVE=price_live_business_monthly_pressmark
STRIPE_AGENCY_PRICE_ID_LIVE=price_live_agency_monthly_pressmark
STRIPE_SINGLE_PASS_PRICE_ID_LIVE=price_live_single_pass_pressmark
STRIPE_STARTER_PACK_PRICE_ID_LIVE=price_live_starter_pack_pressmark

# Live 1-Tap Checkout Payment Links
STRIPE_SOLO_CHECKOUT_URL_LIVE=https://buy.stripe.com/live_pressmark_solo
STRIPE_BUSINESS_CHECKOUT_URL_LIVE=https://buy.stripe.com/live_pressmark_business
STRIPE_AGENCY_CHECKOUT_URL_LIVE=https://buy.stripe.com/live_pressmark_agency
STRIPE_PASS_24H_CHECKOUT_URL_LIVE=https://buy.stripe.com/live_pressmark_doc_unlock
STRIPE_CREDIT_PACK_CHECKOUT_URL_LIVE=https://buy.stripe.com/live_pressmark_credit_pack
STRIPE_CHECKOUT_BASE_URL=https://buy.stripe.com/live_pressmark

# HighLevel CRM Integration (Supports standard GHL_* and HIGHLEVEL_* keys)
GHL_LOCATION_ID=TnDcaRLbCxm7LnOUF173
GHL_LOCATION_PIT=pit-replace-with-live-highlevel-agency-key
HIGHLEVEL_LOCATION_ID=TnDcaRLbCxm7LnOUF173
HIGHLEVEL_API_KEY=pit-replace-with-live-highlevel-agency-key
HIGHLEVEL_SYNC_ENABLED=true

# Background Maintenance & Pruning Tasks
PRESSMARK_CACHE_PRUNE_INTERVAL_SECS=1800
PRESSMARK_CACHE_TTL_SECS=3600
PRESSMARK_DB_PRUNE_INTERVAL_SECS=3600
PRESSMARK_STRIPE_EVENT_TTL_DAYS=3

# Observability & Logging
RUST_LOG=pressmark=info,tower_http=info
RUST_BACKTRACE=1
